,164.6 108.6,116.1\" fill=\"url(#rg)\" fill-opacity=\".45\" stroke=\"url(#rg)\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n    <text x=\"150\" y=\"12\" text-anchor=\"middle\" class=\"\">HP</text><text x=\"264.3153532995459\" y=\"78\" text-anchor=\"middle\" class=\"k\">ATK</text><text x=\"264.3153532995459\" y=\"209.99999999999997\" text-anchor=\"middle\" class=\"\">DEF</text><text x=\"150\" y=\"276\" text-anchor=\"middle\" class=\"\">SpATK</text><text x=\"35.684646700454124\" y=\"210.00000000000006\" text-anchor=\"middle\" class=\"\">SpDEF</text><text x=\"35.68464670045411\" y=\"77.99999999999999\" text-anchor=\"middle\" class=\"\">SPD</text></svg><div class=\"stats\"><div class=\"st\"><span class=\"nm \">HP</span>\n    <div class=\"track\" aria-label=\"HP: seu 73, médio 73, máximo 173\"><span class=\"fill\" style=\"width:29.67479674796748%\"></span><span class=\"avg\" style=\"left:29.67479674796748%\"></span><span class=\"top\" style=\"left:calc(70.32520325203252% - 2px)\"></span></div>\n    <span class=\"v\">73</span></div><div class=\"st\"><span class=\"nm key\">ATK</span>\n    <div class=\"track\" aria-label=\"ATK: seu 132, médio 132, máximo 246\"><span class=\"fill\" style=\"width:53.65853658536585%\"></span><span class=\"avg\" style=\"left:53.65853658536585%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">132</span></div><div class=\"st\"><span class=\"nm \">DEF</span>\n    <div class=\"track\" aria-label=\"DEF: seu 83, médio 83, máximo 174\"><span class=\"fill\" style=\"width:33.739837398373986%\"></span><span class=\"avg\" style=\"left:33.739837398373986%\"></span><span class=\"top\" style=\"left:calc(70.73170731707317% - 2px)\"></span></div>\n    <span class=\"v\">83</span></div><div class=\"st\"><span class=\"nm \">SpATK</span>\n    <div class=\"track\" aria-label=\"SpATK: seu 67, médio 67, máximo 150\"><span class=\"fill\" style=\"width:27.235772357723576%\"></span><span class=\"avg\" style=\"left:27.235772357723576%\"></span><span class=\"top\" style=\"left:calc(60.97560975609756% - 2px)\"></span></div>\n    <span class=\"v\">67</span></div><div class=\"st\"><span class=\"nm \">SpDEF</span>\n    <div class=\"track\" aria-label=\"SpDEF: seu 67, médio 67, máximo 150\"><span class=\"fill\" style=\"width:27.235772357723576%\"></span><span class=\"avg\" style=\"left:27.235772357723576%\"></span><span class=\"top\" style=\"left:calc(60.97560975609756% - 2px)\"></span></div>\n    <span class=\"v\">67</span></div><div class=\"st\"><span class=\"nm \">SPD</span>\n    <div class=\"track\" aria-label=\"SPD: seu 79, médio 79, máximo 182\"><span class=\"fill\" style=\"width:32.113821138211385%\"></span><span class=\"avg\" style=\"left:32.113821138211385%\"></span><span class=\"top\" style=\"left:calc(73.98373983739837% - 2px)\"></span></div>\n    <span class=\"v\">79</span></div></div></div><p class=\"note\">Contorno tracejado no radar: exemplar médio. O ponto ao lado do nome marca o stat de ataque dele. Resistência é a média de HP, DEF e SpDEF contra o exemplar médio.</p>"
    },
    "imp": {
      "html": "<p style=\"margin:0\">Os golpes de dano dele são físicos: o <b>ATK</b> (base 90) decide o dano. SpATK não ajuda em nada.</p>\n   <div class=\"mins\">\n    <div><small>Qualidade mínima</small><b>1,3</b><span>sai em ~26% das capturas, cerca de 4</span></div>\n    <div><small>IV de ATK</small><b>20+</b><span>a média é 16,5</span></div>\n    <div><small>IV de HP e DEF</small><b>16+</b><span>define quanto aguenta antes da poção</span></div>\n    <div><small>IV de SPD</small><b>livre</b><span>só encurta a recarga</span></div>\n   </div>\n   <div><b>Para comparar dois Shedinja</b><ol class=\"prio\"><li>Maior qualidade.</li><li>Empate de qualidade (até 0,05): maior IV de ATK.</li><li>Depois IV de HP e DEF.</li><li>P2 e P3 desempatam. P4, P5 ou shiny passam na frente de tudo.</li></ol></div>\n   <div class=\"mult\">\n    <div class=\"mlab\"><b>Bate forte</b><small>esses tipos apanham ×2+ dos golpes dele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#6ba659\"><i></i>Planta<em>×2</em></span><span class=\"type\" style=\"--c:#d06688\"><i></i>Psíquico<em>×2</em></span><span class=\"type\" style=\"--c:#6f6258\"><i></i>Sombrio<em>×2</em></span><span class=\"type\" style=\"--c:#73659a\"><i></i>Fantasma<em>×2</em></span></div>\n    <div class=\"mlab\"><b>Sofre de</b><small>esses tipos batem ×2,5+ nele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#d9774a\"><i></i>Fogo<em>×2,5</em></span><span class=\"type\" style=\"--c:#9a8fd6\"><i></i>Voador<em>×2,5</em></span><span class=\"type\" style=\"--c:#a8975a\"><i></i>Pedra<em>×2,5</em></span><span class=\"type\" style=\"--c:#73659a\"><i></i>Fantasma<em>×2,5</em></span><span class=\"type\" style=\"--c:#6f6258\"><i></i>Sombrio<em>×2,5</em></span></div>\n   </div>"
    },
    "escada": {
      "html": "<p class=\"note\">Shedinja não está no guia de evoluções da comunidade (só Kanto e algumas cadeias). Pelo estágio (última evolução ou não evolui), a regra geral fora de Kanto é: forma do meio no Nv 40, última forma no Nv 100.</p>"
    },
    "hunt-lede": {
      "text": "60 hunts entre o Nv 60 e o Nv 110 simuladas com o seu exemplar. 8 são seguras (no pior intervalo de 5 s ele leva menos de 50% do HP). No topo ficam as que somam mais abates por hora em hunts de nível mais alto, que pagam mais."
    },
