    "verdict": {
      "html": "<div class=\"verdict\"><div class=\"pct ok\">+456%</div>\n     <div><p class=\"call\">Fique com ele.</p><p class=\"muted\" style=\"color:var(--ink-2)\">ATK do seu contra um Crawdaunt médio no mesmo nível. É o stat que define o dano dele.</p></div></div>\n   <div class=\"trio\"><div><small>Resistência vs médio</small><b>+487%</b></div><div><small>ATK do máximo possível</small><b>310%</b></div><div><small>HP de combate</small><b>80.928</b></div></div>"
    },
