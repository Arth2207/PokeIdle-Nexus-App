    "ident": {
      "html": "<div class=\"num\" aria-hidden=\"true\">0150</div><div class=\"tag-num\">Nº 0150 · Lendário, ×4 nos stats</div>\n   <h1>Mewtwo</h1><div class=\"types\"><span class=\"type\" style=\"--c:#d06688\"><i></i>Psíquico</span></div>\n   <div class=\"roda\"><svg viewBox=\"0 0 400 400\" role=\"img\" aria-label=\"Roda de ameaças: 3 tipos batem forte nele, 2 batem fraco\">\n    <defs><radialGradient id=\"nucleo\"><stop offset=\"0\" stop-color=\"#d06688\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#d06688\" stop-opacity=\"0\"/></radialGradient></defs>\n    <circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"110\" fill=\"none\" stroke=\"var(--hair)\" stroke-width=\"1\" stroke-dasharray=\"2 6\"/>\n    <line x1=\"200\" y1=\"200\" x2=\"103.6\" y2=\"314.9\" stroke=\"#98a83a\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"52.3\" y2=\"226.0\" stroke=\"#73659a\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"70.1\" y2=\"125.0\" stroke=\"#6f6258\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"78\" fill=\"url(#nucleo)\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"56\" fill=\"var(--room)\" fill-opacity=\".85\" stroke=\"#d06688\" stroke-width=\"2\"/>\n    <text class=\"centro\" x=\"200\" y=\"208\" text-anchor=\"middle\">3</text>\n    <text class=\"centro2\" x=\"200\" y=\"228\" text-anchor=\"middle\">AMEAÇAS</text>\n    <g class=\"no x1\"><title>Normal: ×1</title><circle cx=\"200.0\" cy=\"50.0\" r=\"15\" fill=\"#a8a596\"/>\n      <text x=\"200.0\" y=\"53.5\" text-anchor=\"middle\">Normal</text></g><g class=\"no x1\"><title>Fogo: ×1</title><circle cx=\"251.3\" cy=\"59.0\" r=\"15\" fill=\"#d9774a\"/>\n      <text x=\"251.3\" y=\"62.5\" text-anchor=\"middle\">Fogo</text></g><g class=\"no x1\"><title>Água: ×1</titl