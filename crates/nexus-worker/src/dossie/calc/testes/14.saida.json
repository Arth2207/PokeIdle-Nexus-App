fill=\"#b0483f\"/>\n      <text x=\"329.9\" y=\"274.0\" text-anchor=\"middle\"></text><text x=\"329.9\" y=\"278.5\" text-anchor=\"middle\" style=\"font-size:10px\">½</text></g><g class=\"no forte\"><title>Veneno: ×2</title><circle class=\"halo\" cx=\"296.4\" cy=\"314.9\" r=\"31\" fill=\"#9a5c9a\" fill-opacity=\".25\"/><circle cx=\"296.4\" cy=\"314.9\" r=\"22\" fill=\"#9a5c9a\"/>\n      <text x=\"296.4\" y=\"313.9\" text-anchor=\"middle\">Veneno</text><text x=\"296.4\" y=\"324.9\" text-anchor=\"middle\" style=\"font-size:11px\">×2</text></g><g class=\"no imu\"><title>Terra: não causa dano</title><circle cx=\"251.3\" cy=\"341.0\" r=\"14\" fill=\"none\" stroke=\"var(--ink-3)\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><circle cx=\"251.3\" cy=\"341.0\" r=\"11\" fill=\"#c4a663\"/>\n      <text x=\"251.3\" y=\"340.0\" text-anchor=\"middle\"></text><text x=\"251.3\" y=\"344.5\" text-anchor=\"middle\" style=\"font-size:10px\">×0</text></g><g class=\"no forte\"><title>Voador: ×2</title><circle class=\"halo\" cx=\"200.0\" cy=\"350.0\" r=\"31\" fill=\"#9a8fd6\" fill-opacity=\".25\"/><circle cx=\"200.0\" cy=\"350.0\" r=\"22\" fill=\"#9a8fd6\"/>\n      <text x=\"200.0\" y=\"349.0\" text-anchor=\"middle\">Voador</text><text x=\"200.0\" y=\"360.0\" text-anchor=\"middle\" style=\"font-size:11px\">×2</text></g><g class=\"no x1\"><title>Psíquico: ×1</title><circle cx=\"148.7\" cy=\"341.0\" r=\"15\" fill=\"#d06688\"/>\n      <text x=\"148.7\" y=\"344.5\" text-anchor=\"middle\">Psíqu.</text></g><g class=\"no x1\"><title>Inseto: ×1</title><circle cx=\"103.6\" cy=\"314.9\" r=\"15\" fill=\"#98a83a\"/>\n      <text x=\"103.6\" y=\"318.4\" text-anchor=\"middle\">Inseto</text></g><g class=\"no forte\"><title>Pedra: ×2</title><circle class=\"halo\" cx=\"70.1\" cy=\"275.0\" r=\"31\" fill=\"#a8975a\" fill-opacity=\".25\"/><circle cx=\"70.1\" cy=\"275.0\" r=\"22\" fill=\"#a8975a\"/>\n      <text x=\"70.1\" y=\"274.0\" text-anchor=\"middle\">Pedra</text><text x=\"70.1\" y=\"285.0\" text-anchor=\"middle\" style=\"font-size:11px\">×2</text></g><g class=\"no x1\"><title>Fantasma: ×1</title><circle cx=\"52.3\" cy=\"226.0\" r=\"15\" fill=\"#73659a\"/>\n      <text x=\"52.3\" y=\"229.5\" text-anchor=\"middle\">Fanta.</text></g><g class=\"no x1\"><title>Dragão: ×1</title><circle cx=\"52.3\" cy=\"174.0\" r=\"15\" fill=\"#6c58c8\"/>\n      <text x=\"52.3\" y=\"177.5\" text-anchor=\"middle\">Dragão</text></g><g class=\"no x1\"><title>Sombrio: ×1</title><circle cx=\"70.1\" cy=\"125.0\" r=\"15\" fill=\"#6f6258\"/>\n      <text x=\"70.1\" y=\"128.5\" text-anchor=\"middle\">Sombr.</text></g><g class=\"no x1\"><title>Metálico: ×1</title><circle cx=\"103.6\" cy=\"85.1\" r=\"15\" fill=\"#9ea3b3\"/>\n      <text x=\"103.6\" y=\"88.6\" text-anchor=\"middle\">Metál.</text></g><g class=\"no x1\"><title>Fada: ×1</title><circle cx=\"148.7\" cy=\"59.0\" r=\"15\" fill=\"#d996aa\"/>\n      <text x=\"148.7\" y=\"62.5\" text-anchor=\"middle\">Fada</text></g></svg>\n    <div class=\"leg\"><span><i style=\"background:var(--bad)\"></i>batem forte: Fogo, Gelo, Veneno, Voador, Pedra</span><span><i style=\"background:var(--ink-3)\"></i>resiste a 3 · imune a Terra</span></div></div><dl class=\"facts\"><div><dt>Origem</dt><dd>Hunt Nv 200</dd></div><div><dt>Captura no</dt><dd>Nv 20</dd></div><div><dt>BST</dt><dd>250</dd></div>\n   <div><dt>Ataca com</dt><dd>Físico, usa ATK</dd></div><div><dt>Estágio</dt><dd>1º de cadeia de três</dd></div><div><dt>Golpes de 600</dt><dd>0</dd></div></dl>"
    },
    "verdict": {
      "html": "<div class=\"verdict\"><div class=\"pct warn\">+0%</div>\n     <div><p class=\"call\">Na média. Serve até aparecer um melhor.</p><p class=\"muted\" style=\"color:var(--ink-2)\">ATK do seu contra um Hoppip médio no mesmo nível. É o stat que define o dano dele.</p></div></div>\n   <div class=\"trio\"><div><small>Resistência vs médio</small><b>+0%</b></div><div><small>ATK do máximo possível</small><b>50%</b></div><div><small>HP de combate</small><b>24</b></div></div>"
    },
    "stats": {
      "html": "<div class=\"radar-wrap\"><svg class=\"radar\" viewBox=\"0 0 300 280\" role=\"img\" aria-label=\"Radar dos stats contra o máximo\"><defs><linearGradient id=\"rg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"var(--t1)\"/><stop offset=\"1\" stop-color=\"var(--t2)\"/></linearGradient></defs>\n    <polygon points=\"150,30 245.26279441628824,85 245.26279441628827,194.99999999999997 150,250 54.73720558371177,195.00000000000003 54.737205583711756,84.99999999999999\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/><polygon points=\"150,57.5 221.4470958122162,98.75 221.4470958122162,181.25 150,222.5 78.55290418778382,181.25000000000003 78.55290418778381,98.74999999999999\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/><polygon points=\"150,85 197.6313972081441,112.5 197.63139720814414,167.5 150,195 102.36860279185589,167.50000000000003 102.36860279185588,112.5\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/><polygon points=\"150,112.5 173.81569860407205,126.25 173.81569860407205,153.75 150,167.5 126.18430139592795,153.75 126.18430139592795,126.25\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/>\n    <line x1=\"150\" y1=\"140\" x2=\"150\" y2=\"30\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"245.26279441628824\" y2=\"85\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"245.26279441628827\" y2=\"194.99999999999997\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"150\" y2=\"250\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"54.73720558371177\" y2=\"195.00000000000003\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"54.737205583711756\" y2=\"84.99999999999999\" stroke=\"var(--hair)\"/>\n    <polygon points=\"150.0,85.0 197.6,112.5 197.6,167.5 150.0,195.0 102.4,167.5 102.4,112.5\" fill=\"none\" stroke=\"var(--ink-2)\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\"/>\n    <polygon points=\"150.0,85.0 197.6,112.5 197.6,167.5 150.0,195.0 102.4,167.5 102.4,112.5\" fill=\"url(#rg)\" fill-opacity=\".45\" stroke=\"url(#rg)\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n    <text x=\"150\" y=\"12\" text-anchor=\"middle\" class=\"\">HP</text><text x=\"264.3153532995459\" y=\"78\" text-anchor=\"middle\" class=\"k\">ATK</text><text x=\"264.3153532995459\" y=\"209.99999999999997\" text-anchor=\"middle\" class=\"\">DEF</text><text x=\"150\" y=\"276\" text-anchor=\"middle\" class=\"\">SpATK</text><text x=\"35.684646700454124\" y=\"210.00000000000006\" text-anchor=\"middle\" class=\"\">SpDEF</text><text x=\"35.68464670045411\" y=\"77.99999999999999\" text-anchor=\"middle\" class=\"\">SPD</text></svg><div class=\"stats\"><div class=\"st\"><span class=\"nm \">HP</span>\n    <div class=\"track\" aria-label=\"HP: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm key\">ATK</span>\n    <div class=\"track\" aria-label=\"ATK: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">DEF</span>\n    <div class=\"track\" aria-label=\"DEF: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">SpATK</span>\n    <div class=\"track\" aria-label=\"SpATK: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">SpDEF</span>\n    <div class=\"track\" aria-label=\"SpDEF: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">SPD</span>\n    <div class=\"track\" aria-label=\"SPD: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div></div></div><p class=\"note\">Contorno tracejado no radar: exemplar médio. O ponto ao lado do nome marca o stat de ataque dele. Resistência é a média de HP, DEF e SpDEF contra o exemplar médio.</p>"
    },
    "imp": {
      "html": "<p style=\"margin:0\">Os golpes de dano dele são físicos: o <b>ATK</b> (base 35) decide o dano. SpATK não ajuda em nada.</p>\n   <div class=\"mins\">\n    <div><small>Qualidade mínima</small><b>1,3</b><span>sai em ~26% das capturas, cerca de 4</span></div>\n    <div><small>IV de ATK</small><b>20+</b><span>a média é 16,5</span></div>\n    <div><small>IV de HP e SpDEF</small><b>16+</b><span>define quanto aguenta antes da poção</span></div>\n    <div><small>IV de SPD</small><b>livre</b><span>só encurta a recarga</span></div>\n   </div>\n   <div><b>Para comparar dois Hoppip</b><ol class=\"prio\"><li>Maior qualidade.</li><li>Empate de qualidade (até 0,05): maior IV de ATK.</li><li>Depois IV de HP e SpDEF.</li><li>P2 e P3 desempatam. P4, P5 ou shiny passam na frente de tudo.</li></ol></div>\n   <div class=\"mult\">\n    <div class=\"mlab\"><b>Bate forte</b><small>esses tipos apanham ×2+ dos golpes dele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#5d84cf\"><i></i>Água<em>×2</em></span><span class=\"type\" style=\"--c:#c4a663\"><i></i>Terra<em>×2</em></span><span class=\"type\" style=\"--c:#a8975a\"><i></i>Pedra<em>×2</em></span><span class=\"type\" style=\"--c:#6ba659\"><i></i>Planta<em>×2</em></span><span class=\"type\" style=\"--c:#b0483f\"><i></i>Lutador<em>×2</em></span><span class=\"type\" style=\"--c:#98a83a\"><i></i>Inseto<em>×2</em></span></div>\n    <div class=\"mlab\"><b>Sofre de</b><small>esses tipos batem ×2,5+ nele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#d9774a\"><i></i>Fogo<em>×2,5</em></span><span class=\"type\" style=\"--c:#7fc2c2\"><i></i>Gelo<em>×5,5</em></span><span class=\"type\" style=\"--c:#9a5c9a\"><i></i>Veneno<em>×2,5</em></span><span class=\"type\" style=\"--c:#9a8fd6\"><i></i>Voador<em>×2,5</em></span><span class=\"type\" style=\"--c:#a8975a\"><i></i>Pedra<em>×2,5</em></span></div>\n   </div>"
    },
    "escada": {
      "html": "<p class=\"note\">Hoppip não está no guia de evoluções da comunidade (só Kanto e algumas cadeias). Pelo estágio (1º de cadeia de três), a regra geral fora de Kanto é: forma do meio no Nv 40, última forma no Nv 100.</p>"
    },
    "hunt-lede": {
      "text": "32 hunts entre o Nv 1 e o Nv 11 simuladas com o seu exemplar. 1 são seguras (no pior intervalo de 5 s ele leva menos de 50% do HP). No topo ficam as que somam mais abates por hora em hunts de nível mais alto, que pagam mais."
    },
