    "ident": {
      "html": "<div class=\"num\" aria-hidden=\"true\">0933</div><div class=\"tag-num\">Nº 0933</div>\n   <h1>Naclstack</h1><div class=\"types\"><span class=\"type\" style=\"--c:#a8975a\"><i></i>Pedra</span></div>\n   <div class=\"roda\"><svg viewBox=\"0 0 400 400\" role=\"img\" aria-label=\"Roda de ameaças: 5 tipos batem forte nele, 4 batem fraco\">\n    <defs><radialGradient id=\"nucleo\"><stop offset=\"0\" stop-color=\"#a8975a\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#a8975a\" stop-opacity=\"0\"/></radialGradient></defs>\n    <circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"110\" fill=\"none\" stroke=\"var(--hair)\" stroke-width=\"1\" stroke-dasharray=\"2 6\"/>\n    <line x1=\"200\" y1=\"200\" x2=\"296.4\" y2=\"85.1\" stroke=\"#5d84cf\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"329.9\" y2=\"125.0\" stroke=\"#6ba659\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"329.9\" y2=\"275.0\" stroke=\"#b0483f\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"251.3\" y2=\"341.0\" stroke=\"#c4a663\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"103.6\" y2=\"85.1\" stroke=\"#9ea3b3\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"78\" fill=\"url(#nucleo)\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"56\" fill=\"var(--room)\" fill-opacity=\".85\" stroke=\"#a8975a\" stroke-width=\"2\"/>\n    <text class=\"centro\" x=\"200\" y=\"208\" text-anchor=\"middle\">5</text>\n    <text class=\"centro2\" x=\"200\" y=\"228\" text-anchor=\"middle\">AMEAÇAS</text>\n    <g class=\"no res\"><title>Normal: ×0,5</title><circle cx=\"200.0\" cy=\"50.0\" r=\"16\" fill=\"none\" stroke=\"var(--ink-3)\" stroke-wid