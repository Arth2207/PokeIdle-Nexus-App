    "ident": {
      "html": "<div class=\"num\" aria-hidden=\"true\">0435</div><div class=\"tag-num\">Nº 0435</div>\n   <h1>Skuntank</h1><div class=\"types\"><span class=\"type\" style=\"--c:#9a5c9a\"><i></i>Veneno</span><span class=\"type\" style=\"--c:#6f6258\"><i></i>Sombrio</span></div>\n   <div class=\"roda\"><svg viewBox=\"0 0 400 400\" role=\"img\" aria-label=\"Roda de ameaças: 1 tipos batem forte nele, 5 batem fraco\">\n    <defs><radialGradient id=\"nucleo\"><stop offset=\"0\" stop-color=\"#9a5c9a\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#6f6258\" stop-opacity=\"0\"/></radialGradient></defs>\n    <circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"110\" fill=\"none\" stroke=\"var(--hair)\" stroke-width=\"1\" stroke-dasharray=\"2 6\"/>\n    <line x1=\"200\" y1=\"200\" x2=\"251.3\" y2=\"341.0\" stroke=\"#c4a663\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"78\" fill=\"url(#nucleo)\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"56\" fill=\"var(--room)\" fill-opacity=\".85\" stroke=\"#9a5c9a\" stroke-width=\"2\"/>\n    <text class=\"centro\" x=\"200\" y=\"208\" text-anchor=\"middle\">1</text>\n    <text class=\"centro2\" x=\"200\" y=\"228\" text-anchor=\"middle\">AMEAÇAS</text>\n    <g class=\"no x1\"><title>Normal: ×1</title><circle cx=\"200.0\" cy=\"50.0\" r=\"15\" fill=\"#a8a596\"/>\n      <text x=\"200.0\" y=\"53.5\" text-anchor=\"middle\">Normal</text></g><g class=\"no x1\"><title>Fogo: ×1</title><circle cx=\"251.3\" cy=\"59.0\" r=\"15\" fill=\"#d9774a\"/>\n      <text x=\"251.3\" y=\"62.5\" text-anchor=\"middle\">Fogo</text></g><g class=\"no x1\"><title>Água: ×1</title><circle cx=\"296.4\" cy=\"85.1\" r=\"15\" fill=\"#5d84cf\"/>\n      <text x=\"296.4\" y=\"88.6\" text-anchor=\"middle\">Água</text></g><g class=\"no res\"><title>Planta: ×0,5</title><circle cx=\"329.9\" cy=\"125.0\" r=\"16\" fill=\"none\" stro