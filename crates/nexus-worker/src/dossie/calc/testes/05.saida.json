    "verdict": {
      "html": "<div class=\"verdict\"><div class=\"pct warn\">+0%</div>\n     <div><p class=\"call\">Na média. Serve até aparecer um melhor.</p><p class=\"muted\" style=\"color:var(--ink-2)\">SpATK do seu contra um Rayquaza médio no mesmo nível. É o stat que define o dano dele.</p></div></div>\n   <div class=\"trio\"><div><small>Resistência vs médio</small><b>+0%</b></div><div><small>SpATK do máximo possível</small><b>57%</b></div><div><small>HP de combate</small><b>7.200</b></div></div>"
    },
    "stats": {
