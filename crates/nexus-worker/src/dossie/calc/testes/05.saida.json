69.4 102.4,112.5\" fill=\"url(#rg)\" fill-opacity=\".45\" stroke=\"url(#rg)\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n    <text x=\"150\" y=\"12\" text-anchor=\"middle\" class=\"\">HP</text><text x=\"264.3153532995459\" y=\"78\" text-anchor=\"middle\" class=\"\">ATK</text><text x=\"264.3153532995459\" y=\"209.99999999999997\" text-anchor=\"middle\" class=\"\">DEF</text><text x=\"150\" y=\"276\" text-anchor=\"middle\" class=\"k\">SpATK</text><text x=\"35.684646700454124\" y=\"210.00000000000006\" text-anchor=\"middle\" class=\"\">SpDEF</text><text x=\"35.68464670045411\" y=\"77.99999999999999\" text-anchor=\"middle\" class=\"\">SPD</text></svg><div class=\"stats\"><div class=\"st\"><span class=\"nm \">HP</span>\n    <div class=\"track\" aria-label=\"HP: seu 600, médio 600, máximo 1182\"><span class=\"fill\" style=\"width:43.7956204379562%\"></span><span class=\"avg\" style=\"left:43.7956204379562%\"></span><span class=\"top\" style=\"left:calc(86.27737226277372% - 2px)\"></span></div>\n    <span class=\"v\">600</span></div><div class=\"st\"><span class=\"nm \">ATK</span>\n    <div class=\"track\" aria-label=\"ATK: seu 786, médio 786, máximo 1370\"><span class=\"fill\" style=\"width:57.372262773722625%\"></span><span class=\"avg\" style=\"left:57.372262773722625%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">786</span></div><div class=\"st\"><span class=\"nm \">DEF</span>\n    <div class=\"track\" aria-label=\"DEF: seu 527, médio 527, máximo 986\"><span class=\"fill\" style=\"width:38.46715328467153%\"></span><span class=\"avg\" style=\"left:38.46715328467153%\"></span><span class=\"top\" style=\"left:calc(71.97080291970804% - 2px)\"></span></div>\n    <span class=\"v\">527</span></div><div class=\"st\"><span class=\"nm key\">SpATK</span>\n    <div class=\"track\" aria-label=\"SpATK: seu 786, médio 786, máximo 1370\"><span class=\"fill\" style=\"width:57.372262773722625%\"></span><span class=\"avg\" style=\"left:57.372262773722625%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">786</span></div><div class=\"st\"><span class=\"nm \">SpDEF</span>\n    <div class=\"track\" aria-label=\"SpDEF: seu 527, médio 527, máximo 986\"><span class=\"fill\" style=\"width:38.46715328467153%\"></span><span class=\"avg\" style=\"left:38.46715328467153%\"></span><span class=\"top\" style=\"left:calc(71.97080291970804% - 2px)\"></span></div>\n    <span class=\"v\">527</span></div><div class=\"st\"><span class=\"nm \">SPD</span>\n    <div class=\"track\" aria-label=\"SPD: seu 556, médio 556, máximo 1112\"><span class=\"fill\" style=\"width:40.583941605839414%\"></span><span class=\"avg\" style=\"left:40.583941605839414%\"></span><span class=\"top\" style=\"left:calc(81.16788321167883% - 2px)\"></span></div>\n    <span class=\"v\">556</span></div></div></div><p class=\"note\">Contorno tracejado no radar: exemplar médio. O ponto ao lado do nome marca o stat de ataque dele. Resistência é a média de HP, DEF e SpDEF contra o exemplar médio.</p>"
    },
    "imp": {
      "html": "<p style=\"margin:0\">Os golpes de dano dele são especiais: o <b>SpATK</b> (base 150) decide o dano. ATK só pesa na Investida, que é física.</p>\n   <div class=\"mins\">\n    <div><small>Qualidade mínima</small><b>1,3</b><span>sai em ~26% das capturas, cerca de 4</span></div>\n    <div><small>IV de SpATK</small><b>20+</b><span>a média é 16,5</span></div>\n    <div><small>IV de HP e DEF</small><b>16+</b><span>define quanto aguenta antes da poção</span></div>\n    <div><small>IV de SPD</small><b>livre</b><span>só encurta a recarga</span></div>\n   </div>\n   <div><b>Para comparar dois Rayquaza</b><ol class=\"prio\"><li>Maior qualidade.</li><li>Empate de qualidade (até 0,05): maior IV de SpATK.</li><li>Depois IV de HP e DEF.</li><li>P2 e P3 desempatam. P4, P5 ou shiny passam na frente de tudo.</li></ol></div>\n   <div class=\"mult\">\n    <div class=\"mlab\"><b>Bate forte</b><small>esses tipos apanham ×2+ dos golpes dele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#6ba659\"><i></i>Planta<em>×2</em></span><span class=\"type\" style=\"--c:#b0483f\"><i></i>Lutador<em>×2</em></span><span class=\"type\" style=\"--c:#98a83a\"><i></i>Inseto<em>×2</em></span><span class=\"type\" style=\"--c:#6c58c8\"><i></i>Dragão<em>×2</em></span></div>\n    <div class=\"mlab\"><b>Sofre de</b><small>esses tipos batem ×2,5+ nele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#7fc2c2\"><i></i>Gelo<em>×5,5</em></span><span class=\"type\" style=\"--c:#a8975a\"><i></i>Pedra<em>×2,5</em></span><span class=\"type\" style=\"--c:#6c58c8\"><i></i>Dragão<em>×2,5</em></span><span class=\"type\" style=\"--c:#d996aa\"><i></i>Fada<em>×2,5</em></span></div>\n   </div>"
    },
    "escada": {
      "html": "<p class=\"note\">Rayquaza não está no guia de evoluções da comunidade (só Kanto e algumas cadeias). </p>"
    },
    "hunt-lede": {
      "text": "60 hunts entre o Nv 60 e o Nv 110 simuladas com o seu exemplar. 56 são seguras (no pior intervalo de 5 s ele leva menos de 50% do HP). No topo ficam as que somam mais abates por hora em hunts de nível mais alto, que pagam mais."
    },
