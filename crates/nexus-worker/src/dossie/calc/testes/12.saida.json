52.3\" cy=\"174.0\" r=\"15\" fill=\"#6c58c8\"/>\n      <text x=\"52.3\" y=\"177.5\" text-anchor=\"middle\">Dragão</text></g><g class=\"no forte\"><title>Sombrio: ×2</title><circle class=\"halo\" cx=\"70.1\" cy=\"125.0\" r=\"31\" fill=\"#6f6258\" fill-opacity=\".25\"/><circle cx=\"70.1\" cy=\"125.0\" r=\"22\" fill=\"#6f6258\"/>\n      <text x=\"70.1\" y=\"124.0\" text-anchor=\"middle\">Sombr.</text><text x=\"70.1\" y=\"135.0\" text-anchor=\"middle\" style=\"font-size:11px\">×2</text></g><g class=\"no x1\"><title>Metálico: ×1</title><circle cx=\"103.6\" cy=\"85.1\" r=\"15\" fill=\"#9ea3b3\"/>\n      <text x=\"103.6\" y=\"88.6\" text-anchor=\"middle\">Metál.</text></g><g class=\"no res\"><title>Fada: ×0,5</title><circle cx=\"148.7\" cy=\"59.0\" r=\"16\" fill=\"none\" stroke=\"var(--ink-3)\" stroke-width=\"1\" stroke-dasharray=\"\"/><circle cx=\"148.7\" cy=\"59.0\" r=\"13\" fill=\"#d996aa\"/>\n      <text x=\"148.7\" y=\"58.0\" text-anchor=\"middle\"></text><text x=\"148.7\" y=\"62.5\" text-anchor=\"middle\" style=\"font-size:10px\">½</text></g></svg>\n    <div class=\"leg\"><span><i style=\"background:var(--bad)\"></i>batem forte: Terra, Psíquico, Fantasma, Sombrio</span><span><i style=\"background:var(--ink-3)\"></i>resiste a 4 · imune a Normal, Lutador</span></div></div><dl class=\"facts\"><div><dt>Origem</dt><dd>Hunt Nv 100</dd></div><div><dt>Captura no</dt><dd>Nv 100</dd></div><div><dt>BST</dt><dd>500</dd></div>\n   <div><dt>Ataca com</dt><dd>Especial, usa SpATK</dd></div><div><dt>Estágio</dt><dd>Última evolução ou não evolui</dd></div><div><dt>Golpes de 600</dt><dd>2</dd></div></dl>"
