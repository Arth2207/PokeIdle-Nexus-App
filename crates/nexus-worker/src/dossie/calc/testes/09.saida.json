    "ident": {
      "html": "<div class=\"num\" aria-hidden=\"true\">0001</div><div class=\"tag-num\">Nº 0001</div>\n   <h1>Bulbasaur</h1><div class=\"types\"><span class=\"type\" style=\"--c:#6ba659\"><i></i>Planta</span><span class=\"type\" style=\"--c:#9a5c9a\"><i></i>Veneno</span></div>\n   <div class=\"roda\"><svg viewBox=\"0 0 400 400\" role=\"img\" aria-label=\"Roda de ameaças: 4 tipos batem forte nele, 5 batem fraco\">\n    <defs><radialGradient id=\"nucleo\"><stop offset=\"0\" stop-color=\"#6ba659\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#9a5c9a\" stop-opacity=\"0\"/></radialGradient></defs>\n    <circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"110\" fill=\"none\" stroke=\"var(--hair)\" stroke-width=\"1\" stroke-dasharray=\"2 6\"/>\n    <line x1=\"200\" y1=\"200\" x2=\"251.3\" y2=\"59.0\" stroke=\"#d9774a\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"347.7\" y2=\"226.0\" stroke=\"#7fc2c2\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"200.0\" y2=\"350.0\" stroke=\"#9a8fd6\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"148.7\" y2=\"341.0\" stroke=\"#d06688\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"78\" fill=\"url(#nucleo)\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"56\" fill=\"var(--room)\" fill-opacity=\".85\" stroke=\"#6ba659\" stroke-width=\"2\"/>\n    <text class=\"centro\" x=\"200\" y=\"208\" text-anchor=\"middle\">4</text>\n    <text class=\"centro2\" x=\"200\" y=\"228\" text-anchor=\"middle\">AMEAÇAS</text>\n    <g class=\"no x1\"><title>Normal: ×1</title><circle cx=\"200.0\" cy=\"50.0\" r=\"15\" fill=\"#a8a596\"/>\n      <text x=\"200.0\" y=\"53.5\" text-anchor=\"middle\">Normal</text></g><g class=\"no forte\"><title>Fogo: