\"1\" stroke-dasharray=\"\"/><circle cx=\"329.9\" cy=\"275.0\" r=\"13\" fill=\"#b0483f\"/>\n      <text x=\"329.9\" y=\"274.0\" text-anchor=\"middle\"></text><text x=\"329.9\" y=\"278.5\" text-anchor=\"middle\" style=\"font-size:10px\">½</text></g><g class=\"no x1\"><title>Veneno: ×1</title><circle cx=\"296.4\" cy=\"314.9\" r=\"15\" fill=\"#9a5c9a\"/>\n      <text x=\"296.4\" y=\"318.4\" text-anchor=\"middle\">Veneno</text></g><g class=\"no x1\"><title>Terra: ×1</title><circle cx=\"251.3\" cy=\"341.0\" r=\"15\" fill=\"#c4a663\"/>\n      <text x=\"251.3\" y=\"344.5\" text-anchor=\"middle\">Terra</text></g><g class=\"no forte\"><title>Voador: ×2</title><circle class=\"halo\" cx=\"200.0\" cy=\"350.0\" r=\"31\" fill=\"#9a8fd6\" fill-opacity=\".25\"/><circle cx=\"200.0\" cy=\"350.0\" r=\"22\" fill=\"#9a8fd6\"/>\n      <text x=\"200.0\" y=\"349.0\" text-anchor=\"middle\">Voador</text><text x=\"200.0\" y=\"360.0\" text-anchor=\"middle\" style=\"font-size:11px\">×2</text></g><g class=\"no forte\"><title>Psíquico: ×2</title><circle class=\"halo\" cx=\"148.7\" cy=\"341.0\" r=\"31\" fill=\"#d06688\" fill-opacity=\".25\"/><circle cx=\"148.7\" cy=\"341.0\" r=\"22\" fill=\"#d06688\"/>\n      <text x=\"148.7\" y=\"340.0\" text-anchor=\"middle\">Psíqu.</text><text x=\"148.7\" y=\"351.0\" text-anchor=\"middle\" style=\"font-size:11px\">×2</text></g><g class=\"no x1\"><title>Inseto: ×1</title><circle cx=\"103.6\" cy=\"314.9\" r=\"15\" fill=\"#98a83a\"/>\n      <text x=\"103.6\" y=\"318.4\" text-anchor=\"middle\">Inseto</text></g><g class=\"no x1\"><title>Pedra: ×1</title><circle cx=\"70.1\" cy=\"275.0\" r=\"15\" fill=\"#a8975a\"/>\n      <text x=\"70.1\" y=\"278.5\" text-anchor=\"middle\">Pedra</text></g><g class=\"no x1\"><title>Fantasma: ×1</title><circle cx=\"52.3\" cy=\"226.0\" r=\"15\" fill=\"#73659a\"/>\n      <text x=\"52.3\" y=\"229.5\" text-anchor=\"middle\">Fanta.</text></g><g class=\"no x1\"><title>Dragão: ×1</title><circle cx=\"52.3\" cy=\"174.0\" r=\"15\" fill=\"#6c58c8\"/>\n      <text x=\"52.3\" y=\"177.5\" text-anchor=\"middle\">Dragão</text></g><g class=\"no x1\"><title>Sombrio: ×1</title><circle cx=\"70.1\" cy=\"125.0\" r=\"15\" fill=\"#6f6258\"/>\n      <text x=\"70.1\" y=\"128.5\" text-anchor=\"middle\">Sombr.</text></g><g class=\"no x1\"><title>Metálico: ×1</title><circle cx=\"103.6\" cy=\"85.1\" r=\"15\" fill=\"#9ea3b3\"/>\n      <text x=\"103.6\" y=\"88.6\" text-anchor=\"middle\">Metál.</text></g><g class=\"no res\"><title>Fada: ×0,5</title><circle cx=\"148.7\" cy=\"59.0\" r=\"16\" fill=\"none\" stroke=\"var(--ink-3)\" stroke-width=\"1\" stroke-dasharray=\"\"/><circle cx=\"148.7\" cy=\"59.0\" r=\"13\" fill=\"#d996aa\"/>\n      <text x=\"148.7\" y=\"58.0\" text-anchor=\"middle\"></text><text x=\"148.7\" y=\"62.5\" text-anchor=\"middle\" style=\"font-size:10px\">½</text></g></svg>\n    <div class=\"leg\"><span><i style=\"background:var(--bad)\"></i>batem forte: Fogo, Gelo, Voador, Psíquico</span><span><i style=\"background:var(--ink-3)\"></i>resiste a 5</span></div></div><dl class=\"facts\"><div><dt>Origem</dt><dd>Hunt Nv 20</dd></div><div><dt>Captura no</dt><dd>Nv 20</dd></div><div><dt>BST</dt><dd>318</dd></div>\n   <div><dt>Ataca com</dt><dd>Especial, usa SpATK</dd></div><div><dt>Estágio</dt><dd>1º de cadeia de três</dd></div><div><dt>Golpes de 600</dt><dd>0</dd></div></dl>"
    },
    "verdict": {
      "html": "<div class=\"verdict\"><div class=\"pct warn\">+0%</div>\n     <div><p class=\"call\">Na média. Serve até aparecer um melhor.</p><p class=\"muted\" style=\"color:var(--ink-2)\">SpATK do seu contra um Bulbasaur médio no mesmo nível. É o stat que define o dano dele.</p></div></div>\n   <div class=\"trio\"><div><small>Resistência vs médio</small><b>+0%</b></div><div><small>SpATK do máximo possível</small><b>50%</b></div><div><small>HP de combate</small><b>24</b></div></div>"
    },
    "stats": {
      "html": "<div class=\"radar-wrap\"><svg class=\"radar\" viewBox=\"0 0 300 280\" role=\"img\" aria-label=\"Radar dos stats contra o máximo\"><defs><linearGradient id=\"rg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"var(--t1)\"/><stop offset=\"1\" stop-color=\"var(--t2)\"/></linearGradient></defs>\n    <polygon points=\"150,30 245.26279441628824,85 245.26279441628827,194.99999999999997 150,250 54.73720558371177,195.00000000000003 54.737205583711756,84.99999999999999\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/><polygon points=\"150,57.5 221.4470958122162,98.75 221.4470958122162,181.25 150,222.5 78.55290418778382,181.25000000000003 78.55290418778381,98.74999999999999\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/><polygon points=\"150,85 197.6313972081441,112.5 197.63139720814414,167.5 150,195 102.36860279185589,167.50000000000003 102.36860279185588,112.5\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/><polygon points=\"150,112.5 173.81569860407205,126.25 173.81569860407205,153.75 150,167.5 126.18430139592795,153.75 126.18430139592795,126.25\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/>\n    <line x1=\"150\" y1=\"140\" x2=\"150\" y2=\"30\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"245.26279441628824\" y2=\"85\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"245.26279441628827\" y2=\"194.99999999999997\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"150\" y2=\"250\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"54.73720558371177\" y2=\"195.00000000000003\" stroke=\"var(--hair)\"/><line x1=\"150\" y1=\"140\" x2=\"54.737205583711756\" y2=\"84.99999999999999\" stroke=\"var(--hair)\"/>\n    <polygon points=\"150.0,85.0 197.6,112.5 197.6,167.5 150.0,195.0 102.4,167.5 102.4,112.5\" fill=\"none\" stroke=\"var(--ink-2)\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\"/>\n    <polygon points=\"150.0,85.0 197.6,112.5 197.6,167.5 150.0,195.0 102.4,167.5 102.4,112.5\" fill=\"url(#rg)\" fill-opacity=\".45\" stroke=\"url(#rg)\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n    <text x=\"150\" y=\"12\" text-anchor=\"middle\" class=\"\">HP</text><text x=\"264.3153532995459\" y=\"78\" text-anchor=\"middle\" class=\"\">ATK</text><text x=\"264.3153532995459\" y=\"209.99999999999997\" text-anchor=\"middle\" class=\"\">DEF</text><text x=\"150\" y=\"276\" text-anchor=\"middle\" class=\"k\">SpATK</text><text x=\"35.684646700454124\" y=\"210.00000000000006\" text-anchor=\"middle\" class=\"\">SpDEF</text><text x=\"35.68464670045411\" y=\"77.99999999999999\" text-anchor=\"middle\" class=\"\">SPD</text></svg><div class=\"stats\"><div class=\"st\"><span class=\"nm \">HP</span>\n    <div class=\"track\" aria-label=\"HP: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">ATK</span>\n    <div class=\"track\" aria-label=\"ATK: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">DEF</span>\n    <div class=\"track\" aria-label=\"DEF: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm key\">SpATK</span>\n    <div class=\"track\" aria-label=\"SpATK: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">SpDEF</span>\n    <div class=\"track\" aria-label=\"SpDEF: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div><div class=\"st\"><span class=\"nm \">SPD</span>\n    <div class=\"track\" aria-label=\"SPD: seu 1, médio 1, máximo 2\"><span class=\"fill\" style=\"width:50%\"></span><span class=\"avg\" style=\"left:50%\"></span><span class=\"top\" style=\"left:calc(100% - 2px)\"></span></div>\n    <span class=\"v\">1</span></div></div></div><p class=\"note\">Contorno tracejado no radar: exemplar médio. O ponto ao lado do nome marca o stat de ataque dele. Resistência é a média de HP, DEF e SpDEF contra o exemplar médio.</p>"
    },
    "imp": {
      "html": "<p style=\"margin:0\">Os golpes de dano dele são especiais: o <b>SpATK</b> (base 65) decide o dano. ATK só pesa na Investida, que é física.</p>\n   <div class=\"mins\">\n    <div><small>Qualidade mínima</small><b>1,3</b><span>sai em ~26% das capturas, cerca de 4</span></div>\n    <div><small>IV de SpATK</small><b>20+</b><span>a média é 16,5</span></div>\n    <div><small>IV de HP e SpDEF</small><b>16+</b><span>define quanto aguenta antes da poção</span></div>\n    <div><small>IV de SPD</small><b>livre</b><span>só encurta a recarga</span></div>\n   </div>\n   <div><b>Para comparar dois Bulbasaur</b><ol class=\"prio\"><li>Maior qualidade.</li><li>Empate de qualidade (até 0,05): maior IV de SpATK.</li><li>Depois IV de HP e SpDEF.</li><li>P2 e P3 desempatam. P4, P5 ou shiny passam na frente de tudo.</li></ol></div>\n   <div class=\"mult\">\n    <div class=\"mlab\"><b>Bate forte</b><small>esses tipos apanham ×2+ dos golpes dele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#5d84cf\"><i></i>Água<em>×2</em></span><span class=\"type\" style=\"--c:#c4a663\"><i></i>Terra<em>×2</em></span><span class=\"type\" style=\"--c:#a8975a\"><i></i>Pedra<em>×2</em></span></div>\n    <div class=\"mlab\"><b>Sofre de</b><small>esses tipos batem ×2,5+ nele</small></div>\n    <div class=\"chips\"><span class=\"type\" style=\"--c:#d9774a\"><i></i>Fogo<em>×2,5</em></span><span class=\"type\" style=\"--c:#7fc2c2\"><i></i>Gelo<em>×2,5</em></span><span class=\"type\" style=\"--c:#9a8fd6\"><i></i>Voador<em>×2,5</em></span><span class=\"type\" style=\"--c:#d06688\"><i></i>Psíquico<em>×2,5</em></span></div>\n   </div>"
    },
    "escada": {
      "html": "<div class=\"escada\"><div class=\"degrau eu\" style=\"height:144.8px;--a:10%\"><span class=\"pin\">você · Nv 1</span>\n      <small>base</small><span class=\"dn\">Bulbasaur</span><span class=\"bst\">318</span><small>BST · Planta/Veneno</small></div><div class=\"degrau \" style=\"height:168px;--a:28%\"><span class=\"salto\">Nv 40 · +27%</span>\n      <small>evolui no Nv 40</small><span class=\"dn\">Ivysaur</span><span class=\"bst\">405</span><small>BST · Planta/Veneno</small></div><div class=\"degrau \" style=\"height:200px;--a:46%\"><span class=\"salto\">Nv 80 · +30%</span>\n      <small>evolui no Nv 80</small><span class=\"dn\">Venusaur</span><span class=\"bst\">525</span><small>BST · Planta/Veneno</small></div></div><div class=\"escada-base\"></div>\n    <p class=\"escada-prog\">Faltam <b>39 níveis</b> para virar Ivysaur (Nv 40). Fonte: guia da comunidade; confirme a seta \"Precisa de Nv X\" no jogo antes de gastar pedra.</p>"
    },
    "hunt-lede": {
      "text": "32 hunts entre o Nv 1 e o Nv 11 simuladas com o seu exemplar. 0 são seguras (no pior intervalo de 5 s ele leva menos de 50% do HP). No topo ficam as que somam mais abates por hora em hunts de nível mais alto, que pagam mais."
    },
    "hunts": {
      "html": "<p class=\"note\">Nenhuma hunt segura nessa faixa. Suba o nível dele ou teste uma hunt mais baixa abaixo.</p><p style=\"margin:6px 0 0;font-weight:700\">Evite</p><div class=\"tw\"><table><thead><tr><th>Hunt</th><th class=\"r\">Nv</th><th>Tipos</th><th class=\"r\">Bate</th><th class=\"r\">Apanha</th><th class=\"r\">Abates/h</th><th>Pior 5 s</th><th></th></tr></thead><tbody><tr class=\"clk\" data-w=\"Abra\" data-l=\"10\"><td>Abra</td><td class=\"r\">10</td><td><span class=\"type\" style=\"--c:#d06688\"><i></i>Psíquico</span></td><td class=\"r\">×1</td><td class=\"r\">×2,5</td><td class=\"r\">20</td><td><span class=\"mini\"><span style=\"width:100%;background:var(--bad)\"></span><i></i></span> 13.008%</td><td><span class=\"pill bad\">Morre</span></td></tr><tr class=\"clk\" data-w=\"Metapod\" data-l=\"10\"><td>Metapod</td><td class=\"r\">10</td><td><span class=\"type\" style=\"--c:#98a83a\"><i></i>Inseto</span></td><td class=\"r\">×0,333</td><td class=\"r\">×1</td><td class=\"r\">0</td><td><span class=\"mini\"><span style=\"width:100%;background:var(--bad)\"></span><i></i></span> 7.488%</td><td><span class=\"pill bad\">Morre</span></td></tr><tr class=\"clk\" data-w=\"Kakuna\" data-l=\"10\"><td>Kakuna</td><td class=\"r\">10</td><td><span class=\"type\" style=\"--c:#98a83a\"><i></i>Inseto</span> <span class=\"type\" style=\"--c:#9a5c9a\"><i></i>Veneno</span></td><td class=\"r\">×0,167</td><td class=\"r\">×1</td><td class=\"r\">0</td><td><span class=\"mini\"><span style=\"width:100%;background:var(--bad)\"></span><i></i></span> 7.488%</td><td><span class=\"pill bad\">Morre</span></td></tr><tr class=\"clk\" data-w=\"Slowpoke\" data-l=\"10\"><td>Slowpoke</td><td class=\"r\">10</td><td><span class=\"type\" style=\"--c:#5d84cf\"><i></i>Água</span> <span class=\"type\" style=\"--c:#d06688\"><i></i>Psíquico</span></td><td class=\"r\">×2,5</td><td class=\"r\">×2,5</td><td class=\"r\">20</td><td><span class=\"mini\"><span style=\"width:100%;background:var(--bad)\"></span><i></i></span> 6.983%</td><td><span class=\"pill bad\">Morre</span></td></tr></tbody></table></div>"
    },
    "bosses": {
      "html": "<div class=\"tw\"><table><thead><tr><th>Boss</th><th>Nv</th><th>Bate</th><th>Apanha</th><th>Dano / HP do boss</th></tr></thead><tbody><tr><td>Suicune</td><td>650</td><td>×2.5</td><td>×0.333</td><td>0,8%</td></tr><tr><td>Kyogre</td><td>3100</td><td>×2.5</td><td>×0.333</td><td>0,6%</td></tr><tr><td>Raikou</td><td>650</td><td>×1</td><td>×0.333</td><td>0,4%</td></tr><tr><td>Xerneas</td><td>44050</td><td>×2.5</td><td>×0.333</td><td>0,2%</td></tr><tr><td>Groudon</td><td>3100</td><td>×2.5</td><td>×1</td><td>0,2%</td></tr><tr><td>Palkia</td><td>9750</td><td>×1</td><td>×1</td><td>0,2%</td></tr></tbody></table></div><p class=\"note\">Os 6 bosses em que este exemplar entrega mais dano proporcional ao HP estimado, no nível exigido pelo boss. Considera equipe de 5 nesse nível. HP e golpes do boss são estimados pela espécie; confira a equipe completa na aba Equipes.</p>"
    },
    "build": {
      "html": "<div class=\"partner\"><b>Omastar</b><span>Hunt Nv 80</span>\n     <div class=\"why\"><span class=\"type\" style=\"--c:#a8975a\"><i></i>Pedra</span> <span class=\"type\" style=\"--c:#5d84cf\"><i></i>Água</span> &nbsp;Aguenta Fogo, Gelo, Voador. Bate forte em Fogo, Voador, Inseto.</div></div><div class=\"partner\"><b>Brave Steelix</b><span>Hunt Nv 150 na Outland</span>\n     <div class=\"why\"><span class=\"type\" style=\"--c:#9ea3b3\"><i></i>Metálico</span> <span class=\"type\" style=\"--c:#c4a663\"><i></i>Terra</span> &nbsp;Aguenta Psíquico. Bate forte em Veneno, Metálico.</div></div><div class=\"partner\"><b>Dragonite</b><span>Hunt Nv 100</span>\n     <div class=\"why\"><span class=\"type\" style=\"--c:#6c58c8\"><i></i>Dragão</span> <span class=\"type\" style=\"--c:#9a8fd6\"><i></i>Voador</span> &nbsp;Bate forte em Planta, Dragão.</div></div><div class=\"partner\"><b>Arcanine</b><span>Hunt Nv 100</span>\n     <div class=\"why\"><span class=\"type\" style=\"--c:#d9774a\"><i></i>Fogo</span> &nbsp;Reforço de stats (BST 555).</div></div><p class=\"note\">Ele sofre de Fogo, Gelo, Voador, Psíquico; 4 desses tipos ficam cobertos. A escolha é por tipo e BST. Simule cada parceiro selecionando ele na busca.</p>"
