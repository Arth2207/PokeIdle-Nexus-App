    "verdict": {
      "html": "<div class=\"verdict\"><div class=\"pct ok\">+612%</div>\n     <div><p class=\"call\">Fique com ele.</p><p class=\"muted\" style=\"color:var(--ink-2)\">SpATK do seu contra um Mega Chandelure médio no mesmo nível. É o stat que define o dano dele.</p></div></div>\n   <div class=\"trio\"><div><small>Resistência vs médio</small><b>+528%</b></div><div><small>SpATK do máximo possível</small><b>416%</b></div><div><small>HP de combate</small><b>57.216</b></div></div>"
    },
    "stats": {
