    "ident": {
      "html": "<div class=\"num\" aria-hidden=\"true\">0129</div><div class=\"tag-num\">Nº 0129</div>\n   <h1>Magikarp</h1><div class=\"types\"><span class=\"type\" style=\"--c:#5d84cf\"><i></i>Água</span></div>\n   <div class=\"roda\"><svg viewBox=\"0 0 400 400\" role=\"img\" aria-label=\"Roda de ameaças: 2 tipos batem forte nele, 4 batem fraco\">\n    <defs><radialGradient id=\"nucleo\"><stop offset=\"0\" stop-color=\"#5d84cf\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#5d84cf\" stop-opacity=\"0\"/></radialGradient></defs>\n    <circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"var(--hair-2)\" stroke-width=\"1\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"110\" fill=\"none\" stroke=\"var(--hair)\" stroke-width=\"1\" stroke-dasharray=\"2 6\"/>\n    <line x1=\"200\" y1=\"200\" x2=\"329.9\" y2=\"125.0\" stroke=\"#6ba659\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/><line x1=\"200\" y1=\"200\" x2=\"347.7\" y2=\"174.0\" stroke=\"#d6b83a\" stroke-width=\"1.6\" stroke-opacity=\".55\" stroke-dasharray=\"3 5\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"78\" fill=\"url(#nucleo)\"/>\n    <circle cx=\"200\" cy=\"200\" r=\"56\" fill=\"var(--room)\" fill-opacity=\".85\" stroke=\"#5d84cf\" stroke-width=\"2\"/>\n    <text class=\"centro\" x=\"200\" y=\"208\" text-anchor=\"middle\">2</text>\n    <text class=\"centro2\" x=\"200\" y=\"228\" text-anchor=\"middle\">AMEAÇAS</text>\n    <g class=\"no x1\"><title>Normal: ×1</title><circle cx=\"200.0\" cy=\"50.0\" r=\"15\" fill=\"#a8a596\"/>\n      <text x=\"200.0\" y=\"53.5\" text-anchor=\"middle\">Normal</text></g><g class=\"no res\"><title>Fogo: ×0,5</title><circle cx=\"251.3\" cy=\"59.0\" r=\"16\" fill=\"none\" stroke=\"var(--ink-3)\" stroke-width=\"1\" stroke-dasharray=\"\"/><circle cx=\"251.3\" cy=\"59.0\" r=\"13\" fill=\"#d9774a\"/>\n      <text x=\"251.3\" y=\"58.0\" text-anchor=\"middle\"></text><text x=\"251.3\" y=\"62.5\" text-anchor=\"middle\" style=\"font-size:10px\">½</text></g><g