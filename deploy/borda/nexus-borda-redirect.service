[Unit]
Description=Nexus: desvia a porta 8181 da Tailscale para a nexus-borda (cutover das fases 1 e 2)
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/nexus-deploy/cutover-fase1-2.sh redirect-on
ExecStop=/opt/nexus-deploy/cutover-fase1-2.sh redirect-off

[Install]
WantedBy=multi-user.target
